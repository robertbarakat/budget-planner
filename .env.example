# Copia in .env (radice, per backend) e in frontend/.env.local (per Vite). Non committare i file veri.

# --- Frontend (Vite: solo variabili con prefisso VITE_, sono pubbliche) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (segrete: mai nel frontend, mai nei log) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Export su Google Sheets (fase finale)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Protezione degli endpoint chiamati dal cron di Vercel
CRON_SECRET=
