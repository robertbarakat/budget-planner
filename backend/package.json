{
  "name": "budget-planner-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import:read": "node src/import/read-export.ts",
    "import:preview": "node src/import/preview-cli.ts",
    "import:run": "node --env-file-if-exists=../.env src/import/run-import-cli.ts",
    "import:reconcile": "node --env-file-if-exists=../.env src/import/reconcile-cli.ts",
    "import:opening-balances": "node --env-file-if-exists=../.env src/import/opening-balances-cli.ts",
    "import:setup": "node --env-file-if-exists=../.env src/import/master-data-cli.ts",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "budget-planner-shared": "file:../shared",
    "exceljs": "^4.4.0"
  }
}
